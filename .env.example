# Astro World — OPTIONAL environment overrides
# Copy to .env.local and adjust as needed. All values below are optional;
# the app runs with secure defaults when they are unset.

# Path to the Python executable used to run the Swiss Ephemeris engine.
# If unset, the app prefers python_engine/.venv when present, then falls
# back to system "python3" (or "python" on Windows).
# Example (project virtualenv):
# ASTRO_WORLD_PYTHON=python_engine/.venv/bin/python

# Fallback Python executable, checked only if ASTRO_WORLD_PYTHON is unset.
# SIDDHANTA_PYTHON=python_engine/.venv/bin/python

# Secret used to sign/verify auth tokens. Set a strong random value in production.
# AUTH_SECRET=change-me

# When "true", OTP verification is bypassed (development convenience only).
# Defaults to false (secure) when unset.
#
# NOTE: real OTP delivery (email/SMS) is NOT yet wired. deliverOtp() is a stubbed
# seam that only logs the code to the server console in development. Setting
# AUTH_BYPASS_OTP=false in production will therefore leave users unable to receive
# a code until a real delivery provider is integrated in lib/auth.js (deliverOtp).
# AUTH_BYPASS_OTP=false

# When "true", the UI opens directly without registration or login.
# Use only for temporary demos; authenticated features such as saved births
# remain unavailable to guest visitors. Defaults to false when unset.
# NEXT_PUBLIC_GUEST_ACCESS=false

# Max time in milliseconds to wait for a Python calculation before it is
# killed and the request fails with HTTP 504. Defaults to 90000 (90s).
# ASTRO_WORLD_PYTHON_TIMEOUT_MS=90000
